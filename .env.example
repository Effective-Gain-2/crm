# ==== PostgreSQL (db/queries.js) ====
postgres_username=postgres
postgres_host=localhost
postgres_db=postgres
postgres_password=postgres
postgres_port=5432

# ==== Redis / BullMQ (config/Redis.js) ====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==== Auth (controllers/UserController.js) ====
JWT_SECRET=
NODE_ENV=development
COOKIE_DOMAIN=localhost

# ==== Google OAuth / Calendar (index.js, GoogleCalendarController.js) ====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==== Evolution API / WhatsApp (requests/evolution.js) ====
BACKEND_URL=
EVOLUTION_API_KEY=
EVOLUTION_SERVER_URL=

# ==== OpenAI (services/OpenAi.js) ====
OPENAI_KEY=

# ==== Meta Lead Ads webhook (controllers/MetaLeadsController.js) ====
# Callback URL a cadastrar no app Meta: https://crm-api.effectivegain.com/meta-leads
META_VERIFY_TOKEN=            # token de verificação (voce escolhe; mesmo valor no painel Meta)
META_APP_SECRET=             # opcional — valida assinatura X-Hub-Signature-256
META_PAGE_ACCESS_TOKEN=      # token da Página p/ buscar o lead na Graph API
META_LEADS_SCHEMA=effective_gain   # tenant que recebe os leads
META_LEADS_FUNNEL=Vendas           # nome do funil (opportunities.funnel)
# META_LEADS_SECTOR=vendas         # opcional; padrao = 1a letra minuscula do funil
META_LEADS_STAGE=Novo Lead         # etapa alvo (por nome; fallback = 1a etapa)
META_LEADS_SOURCE=Meta ADs
# META_GRAPH_VERSION=v19.0

# ==== Frontend — client/whatsapp-web-js-client/.env (CRA REACT_APP_*) ====
# REACT_APP_URL=http://localhost:3002
# REACT_APP_SOCKET_URL=http://localhost:3333
# REACT_APP_RECAPTCHA_SITE_KEY=
