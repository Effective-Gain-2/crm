# --- Coletor HubSpot → CRM ---
# Copie para collector/.env e preencha. NUNCA commite o .env preenchido.

# View salva no HubSpot (crie uma vez: telefone conhecido + criado recentemente,
# ordenada por data de criação DESC). Cole aqui a URL dela.
HUBSPOT_VIEW_URL=

# Pasta do perfil persistente do navegador (mantém o login salvo).
HUBSPOT_PROFILE_DIR=./.hubspot-profile

# Endpoint de ingestão do CRM (schema do tenant no final).
CRM_INGEST_URL=https://eg-os-crm-backend.cownkm.easypanel.host/hubspot-leads/cdt_nova_iguacu

# Token gerado pelo scripts/config_hubspot_outreach.js (igual ao hubspot_push_token do tenant).
CRM_PUSH_TOKEN=

# false na 1ª vez (login manual). true depois.
HEADLESS=true

# Minutos entre rodadas. 0 = roda uma vez e sai (use com cron/Task Scheduler).
POLL_INTERVAL_MIN=0

# IMAP para ler o código de confirmação do HubSpot (senha de APP, nunca a senha real).
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
